{
  "name": "usdt-arb-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "ts-node --project test/tsconfig.json test/run-test.ts",
    "validate:env": "node -r ts-node/register scripts/validate-env.ts",
    "migrate:help": "echo \"Uses STAGING_DATABASE_URL environment variable. Example: STAGING_DATABASE_URL='******host:5432/db' npm run migrate:staging-node\"",
    "migrate:staging": "psql \"$STAGING_DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/patch-v10-production-safety.sql",
    "migrate:staging-node": "node scripts/run-migration.js"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@circle-fin/smart-contract-platform": "^10.8.0",
    "@dhiwise/component-tagger": "latest",
    "@jest/globals": "^30.4.1",
    "@netlify/database": "^1.1.0",
    "@rocketnew/llm-sdk": "^1.1.0",
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.45.4",
    "axios": "^1.19.0",
    "drizzle-orm": "^1.0.0-beta.22",
    "next": "^15.3.3",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.16.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^1.0.0-beta.22",
    "ffmpeg-static": "^5.3.0",
    "jest": "^30.4.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
