# CE VAULT — Production environment template
# คัดลอกเป็น .env.local แล้วกรอกค่าจริง ห้าม commit .env.local หรือ secret ใด ๆ

# ===== Supabase (server-side only) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Public dashboard key รุ่นใหม่ (legacy ใช้ NEXT_PUBLIC_SUPABASE_ANON_KEY แทนได้)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
# แนะนำ key รุ่นใหม่จาก Settings > API Keys (sb_secret_...)
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
# Legacy fallback เท่านั้น; ใช้แทน SUPABASE_SECRET_KEY ได้ชั่วคราว
# SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-service-role-key
SUPABASE_BUCKET=slips

# ===== API Security =====
# สร้างแยกกันด้วย: openssl rand -hex 32
API_SECRET=replace-with-64-hex-api-secret
# เปิด API ที่ไม่มี key ได้เฉพาะ local development เท่านั้น
ALLOW_INSECURE_DEV_API=0

# ===== Dashboard PIN Gate =====
# PIN 6 หลักสำหรับเข้าหน้า /dashboard (ตัวเลขเท่านั้น)
DASHBOARD_PIN=000000
# ใช้เซ็น session cookie; ถ้าไม่ตั้งจะ fallback ไปใช้ API_SECRET
# สร้างด้วย: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=replace-with-64-hex-session-secret

# ===== Telegram Bot =====
BOT_TOKEN=replace-with-botfather-token
# 16–256 ตัวอักษร: A-Z a-z 0-9 _ - และต้องไม่ซ้ำ API_SECRET
TELEGRAM_WEBHOOK_SECRET=replace-with-independent-webhook-secret
# Telegram user IDs ที่อนุญาตให้ bootstrap เป็น admin (คั่นด้วย comma)
ADMIN_TELEGRAM_IDS=123456789
# ต้องเป็น HTTPS origin ไม่มี path/query
APP_URL=https://your-project.example
# chat_id กลุ่ม/ช่องที่รับแจ้งเตือน (เว้นว่าง = ปิด)
NOTIFY_CHAT_ID=

# ===== Rate & Account Defaults =====
DEFAULT_SELL_RATE=35.5
DEFAULT_MARKET_RATE=34.8
DEFAULT_BANK_ACCOUNT_ID=
FEE_WARNING_THRESHOLD=3

# ===== OCR / Vision =====
# ต้องตั้งอย่างน้อยหนึ่ง provider; Grok รองรับข้อมูลบัญชี/Confidence ได้ครบกว่า
GROK_API_KEY=
GROK_MODEL=grok-4.20-non-reasoning
OCR_SPACE_API_KEY=
# python3 scripts/test_vision.py slip.jpg
# Critical rule: ห้ามต่ำกว่า 90
OCR_AUTO_MIN=90

# ===== Telegram Stickers (optional) =====
STICKER_WELCOME_ID=
STICKER_PROCESSING_ID=
STICKER_OCR_DONE_ID=
STICKER_WAITING_ID=
STICKER_SUCCESS_ID=
STICKER_ERROR_ID=
STICKER_RETRY_ID=
STICKER_THANKYOU_ID=
STICKER_VIP_ID=
STICKER_QUEUE_ID=

# ===== Circle Smart Contract Platform (optional) =====
CIRCLE_API_KEY=
ENTITY_SECRET=
# CIRCLE_SCP_BLOCKCHAIN=ARC-TESTNET
