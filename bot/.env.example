# ===== CE VAULT Dev Bridge (ใช้เฉพาะรันในเครื่อง) =====
# โปรดักชันใช้ Webhook บน Netlify — สคริปต์นี้แค่ forward update เข้า webhook local
BOT_TOKEN=

# ต้องตรงกับ TELEGRAM_WEBHOOK_SECRET ใน .env.local
TELEGRAM_WEBHOOK_SECRET=

LOCAL_WEBHOOK_URL=http://localhost:3000/api/telegram/webhook

# telegram_user_id สำหรับ npm run test:api (ต้องมีในตาราง admins)
TEST_TELEGRAM_ID=123456789
